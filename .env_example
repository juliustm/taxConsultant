# -----------------------------------------------------------------------------
# Local Development Environment Variables
#
# This file is used by `docker-compose.yml` to set environment variables
# for the application during local development.
# -----------------------------------------------------------------------------

# --- Flask Application Settings ---

# A long, random string used by Flask to securely sign session cookies.
# The default is fine for local use, but you can generate a new one with:
# python -c 'import secrets; print(secrets.token_hex(24))'
SECRET_KEY='a-super-secret-key-for-local-development-that-is-very-long'


# --- Asynchronous Task Runner Settings ---

# A secret key to protect the `/tasks/run` endpoint from being triggered by
# unauthorized users. You will use this in your browser or Postman to test
# the queue runner locally.
# Example URL: http://localhost:5000/tasks/run?secret=my-local-cron-job-secret-12345
TASK_RUNNER_SECRET_KEY='my-local-cron-job-secret-12345'


# --- Cookie security ---

# The admin session cookie is marked Secure by default, meaning browsers only send it
# over HTTPS. Local development runs on plain HTTP, where a Secure cookie is never
# sent back and logging in appears to silently do nothing - so it is turned off here.
#
# Leave this unset in production. The scanner PWA also needs HTTPS for the camera and
# for offline mode, so a real deployment has to be on HTTPS regardless.
SESSION_COOKIE_SECURE='false'


# --- Persistence ---

# The one directory holding everything that must survive a deploy: the SQLite
# database (which is also the job queue and the store for your LLM, Google and S3
# credentials) and the uploaded receipt photos.
#
# In production this must be the same absolute path as the platform's persistent
# folder - on Deploy.tz, enter /karani as the persistent folder and set DATA_DIR
# to /karani here. It must not sit under /app: that is the code directory, and a
# deploy replaces it. Point this somewhere new and the app starts with an empty
# database rather than failing, so the value is worth double-checking.
#
# Left unset locally, it defaults to ./karani in the project directory.
# DATA_DIR='/karani'


# --- LLM models (optional) ---

# Which model reads and judges receipts. Normally unset: utils/llm_processor keeps a
# candidate list per provider, walks past any model the provider has retired, and asks
# the provider's own catalogue if every name it knows is gone.
#
# These exist for the day that is not enough - a hosted model can be decommissioned
# overnight, and when Groq retired llama-4-scout every photographed receipt started
# failing with 'model_not_found' on a perfectly valid API key. The same values can be
# set from Settings → Receipt intelligence, which is the better place unless the
# dashboard is unreachable; the configure page wins over these.
# LLM_TEXT_MODEL='llama-3.3-70b-versatile'
# LLM_VISION_MODEL='qwen/qwen3.6-27b'


# --- Notes on Production ---
# On a deployment platform like Deploy.tz, these variables should not be
# uploaded in this file. Instead, they should be set securely through the
# platform's "Environment Variables" dashboard.